+// Busca a lista completa no backend e redesenha a tabela do zero — usado
+// depois de uma importação em lote (não dá pra ir dando prepend() item a
+// item porque o resultado não retorna os equipamentos criados, só um
+// resumo com contagens).
+async function loadInventoryList() {
+    try {
+        const response = await fetch('/equipamentos', {
+            method: 'GET',
+            credentials: 'include',
+            headers: {
+                'X-XSRF-TOKEN': getCsrfToken()
+            }
+        });
+        if (!response.ok) return;
+
+        const itens = await response.json();
+        const tbody = document.getElementById('inventory-table-body');
+        if (!tbody) return;
+
+        tbody.innerHTML = '';
+        if (!itens || itens.length === 0) {
+            tbody.innerHTML = '<tr id="empty-inventory-row"><td colspan="5">Nenhum ativo cadastrado.</td></tr>';
+            return;
+        }
+        itens.forEach(item => addInventoryRowToTable(item));
+    } catch (e) {
+        console.warn('Erro ao carregar lista de inventário:', e);
+    }
+}
+
+// --- 5b. IMPORTAÇÃO DE PLANILHA (INVENTÁRIO) ---
+async function handleImportInventory(event) {
+    const input = event?.target;
+    const arquivo = input?.files?.[0];
+    if (!arquivo) return;
+
+    const formData = new FormData();
+    formData.append('arquivo', arquivo);
+
+    showToast('Importando planilha...', 'info');
+
+    try {
+        const response = await fetch('/equipamentos/importar', {
+            method: 'POST',
+            credentials: 'include',
+            headers: {
+                // NÃO define Content-Type manualmente: o browser precisa
+                // gerar o boundary do multipart/form-data sozinho.
+                'X-XSRF-TOKEN': getCsrfToken()
+            },
+            body: formData
+        });
+
+        const envelope = await response.json().catch(() => null);
+
+        if (!response.ok || !envelope?.sucesso) {
+            throw new Error(envelope?.mensagem || `Erro ${response.status} ao importar a planilha.`);
+        }
+
+        const resultado = envelope.dados || {};
+        const { totalLinhas = 0, importados = 0, ignorados = 0, erros = [] } = resultado;
+
+        if (importados > 0) {
+            showToast(`${importados} de ${totalLinhas} linha(s) importada(s)${ignorados ? `, ${ignorados} ignorada(s)` : ''}.`, 'success');
+        } else {
+            showToast('Nenhuma linha foi importada. Confira o cabeçalho da planilha.', 'error');
+        }
+
+        if (erros.length > 0) {
+            console.warn('Linhas ignoradas na importação:',
+                erros.map(e => `linha ${e.linha}: ${e.motivo}`).join(' | '));
+        }
+
+        await loadInventoryList();
+
+    } catch (error) {
+        console.error('Erro ao importar planilha de inventário:', error);
+        showToast(error.message || 'Falha ao importar a planilha.', 'error');
+    } finally {
+        // Limpa o input pra permitir selecionar o mesmo arquivo de novo
+        // (senão o evento 'change' não dispara numa segunda tentativa).
+        if (input) input.value = '';
+    }
+}
